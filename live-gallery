#!/usr/bin/env python3
"""live-gallery: watch folders recursively and show new images and 3D models in a
browser the moment they appear, newest first, no matter how deeply nested.

    live-gallery [DIR ...] [--port 8765] [--initial 150] [-x DIRNAME] [--poll] [--open]

Standard library only. Uses Linux inotify (instant, idle when nothing changes); falls back
to polling every --interval seconds elsewhere or with --poll.

The page loads the newest files first and older ones on scroll. Thumbnails (3D ones are
rendered in a browser worker) are cached under ~/.cache/live-gallery/thumbs. 3D previews load three.js from a CDN inside the browser.
"""
import argparse
import errno
import hashlib
import json
import mimetypes
import os
import queue
import select
import struct
import sys
import threading
import time
import urllib.parse
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

IMAGE_EXT = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".svg", ".avif", ".ico"}
MODEL_EXT = {".glb", ".gltf", ".obj", ".stl", ".ply", ".fbx"}
# Noise: dependencies, caches, browser/app profiles agents' tooling leaves behind.
SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", "venv", ".mypy_cache", ".pytest_cache",
             ".tox", ".cache", "cache", "Cache", "site-packages", "vendor", "target", ".godot",
             ".import", "tool_profiles", "app_userdata"}

for t, e in [("model/gltf-binary", ".glb"), ("model/gltf+json", ".gltf"), ("image/webp", ".webp"),
             ("image/avif", ".avif"), ("image/svg+xml", ".svg"), ("model/stl", ".stl")]:
    mimetypes.add_type(t, e)


def kind_of(name):
    ext = os.path.splitext(name)[1].lower()
    if ext in IMAGE_EXT:
        return "image", ext
    if ext in MODEL_EXT:
        return "model", ext
    return None, ext


class Inotify:
    """Minimal Linux inotify via ctypes (no dependencies)."""
    CLOSE_WRITE, MOVED_FROM, MOVED_TO, CREATE, DELETE = 0x8, 0x40, 0x80, 0x100, 0x200
    Q_OVERFLOW, IGNORED, ISDIR = 0x4000, 0x8000, 0x40000000
    MASK = CLOSE_WRITE | MOVED_FROM | MOVED_TO | CREATE | DELETE | 0x01000000 | 0x02000000 | 0x04000000  # ONLYDIR|DONT_FOLLOW|EXCL_UNLINK

    def __init__(self):
        import ctypes, ctypes.util
        self.ctypes = ctypes
        self.libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)
        self.fd = self.libc.inotify_init1(0o2000000)  # IN_CLOEXEC
        if self.fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1 failed")

    def add(self, path):
        wd = self.libc.inotify_add_watch(self.fd, os.fsencode(path), self.MASK)
        return wd if wd >= 0 else -self.ctypes.get_errno()

    def rm(self, wd):
        self.libc.inotify_rm_watch(self.fd, wd)

    def close(self):
        os.close(self.fd)

    def events(self, stopped):
        while not stopped():
            try:
                if not select.select([self.fd], [], [], 1.0)[0]:
                    continue
                buf = os.read(self.fd, 1 << 20)
            except InterruptedError:
                continue
            i = 0
            while i + 16 <= len(buf):
                wd, mask, _cookie, n = struct.unpack_from("iIII", buf, i)
                name = buf[i + 16:i + 16 + n].split(b"\0", 1)[0]
                i += 16 + n
                yield wd, mask, os.fsdecode(name)


class Watcher:
    def __init__(self, roots, interval, exclude, poll=False, hub=None):
        self.roots = roots
        self.interval = interval
        self.skip = SKIP_DIRS | set(exclude)
        self.lock = threading.Lock()
        self.items = {}    # (root_index, relpath) -> item
        self.hub = hub     # receives broadcast(event)
        self.stopped = False
        self.pending = {}  # polling mode: key -> (size, mtime) seen once, emitted when stable
        self.wds = {}      # inotify mode: wd -> (root_index, dir path)
        self.warned = False
        self.ino = None
        if not poll:
            try:
                self.ino = Inotify()
            except (OSError, AttributeError) as ex:
                if sys.platform.startswith("linux"):
                    print(f"inotify unavailable ({ex}); polling every {interval}s", file=sys.stderr)

    # ---- scanning ----
    def walk(self, ri, top):
        found, root, stack = {}, self.roots[ri], [top]
        while stack and not self.stopped:
            d = stack.pop()
            if self.ino:
                self.watch(ri, d)  # watch before listing, so nothing slips between
            try:
                it = os.scandir(d)
            except OSError:
                continue
            with it:
                for e in it:
                    try:
                        if e.is_dir(follow_symlinks=False):
                            if e.name not in self.skip:
                                stack.append(e.path)
                            continue
                        kind, ext = kind_of(e.name)
                        if not kind:
                            continue
                        st = e.stat()
                    except OSError:
                        continue
                    found[(ri, os.path.relpath(e.path, root).replace(os.sep, "/"))] = (st.st_size, st.st_mtime, kind, ext)
        return found

    def scan_all(self):
        found = {}
        for ri, root in enumerate(self.roots):
            found.update(self.walk(ri, root))
        return found

    def watch(self, ri, path):
        wd = self.ino.add(path)
        if wd >= 0:
            self.wds[wd] = (ri, path)
        elif wd == -errno.ENOSPC and not self.warned:
            self.warned = True
            print("WARNING: out of inotify watches; some folders are not watched. Narrow the folders, "
                  "add -x excludes, or raise fs.inotify.max_user_watches.", file=sys.stderr, flush=True)

    # ---- state changes ----
    def make_item(self, key, info):
        ri, rel = key
        size, mtime, kind, ext = info
        d, _, name = rel.rpartition("/")
        full = os.path.join(self.roots[ri], *rel.split("/"))
        tkey = hashlib.sha1(f"{full}\0{mtime!r}\0{size}".encode("utf-8", "surrogateescape")).hexdigest()
        return {"id": f"{ri}/{rel}", "rel": rel, "dir": d, "name": name, "kind": kind,
                "ext": ext[1:], "size": size, "mtime": mtime,
                "root": ri, "abs": full, "absdir": os.path.dirname(full),
                "url": f"f/{ri}/" + urllib.parse.quote(rel), "tkey": tkey, "thumb": False}

    def broadcast(self, ev):
        if not self.stopped and self.hub:
            self.hub.broadcast(ev)

    def stop(self):
        self.stopped = True  # loops notice within a second; the inotify fd is closed by its loop

    def upsert(self, key, info):
        now = time.time()
        with self.lock:
            old = self.items.get(key)
            if old and (old["size"], old["mtime"]) == info[:2]:
                return
            item = self.make_item(key, info)
            item["first"] = old["first"] if old else now
            self.items[key] = item
        # a file still settling within 5s of first appearing stays "new"
        ev = "update" if old and now - item["first"] > 5 else "add"
        self.broadcast({"type": ev, "item": item})
        print(f"[{time.strftime('%H:%M:%S')}] {ev:<6} {item['abs']}", flush=True)

    def remove(self, key):
        with self.lock:
            item = self.items.pop(key, None)
        if item:
            self.broadcast({"type": "remove", "id": item["id"], "kind": item["kind"],
                            "rel": item["rel"], "root": item["root"]})

    def sync(self, cur):
        for k, v in cur.items():
            self.upsert(k, v)
        with self.lock:
            gone = [k for k in self.items if k not in cur]
        for k in gone:
            self.remove(k)

    # ---- run ----
    def start(self):
        found = self.scan_all()
        with self.lock:
            for k, v in found.items():
                item = self.make_item(k, v)
                item["first"] = 0
                self.items[k] = item
        loop = self.inotify_loop if self.ino else self.poll_loop
        threading.Thread(target=loop, daemon=True).start()

    def mode(self):
        return f"inotify, {len(self.wds)} folders" if self.ino else f"polling every {self.interval}s"

    def inotify_loop(self):
        try:
            self._inotify_loop()
        finally:
            self.ino.close()

    def _inotify_loop(self):
        I = Inotify
        for wd, mask, name in self.ino.events(lambda: self.stopped):
            try:
                if mask & I.Q_OVERFLOW:
                    print("event queue overflowed; rescanning", file=sys.stderr, flush=True)
                    self.sync(self.scan_all())
                    continue
                if mask & I.IGNORED:
                    self.wds.pop(wd, None)
                    continue
                where = self.wds.get(wd)
                if not where or not name:
                    continue
                ri, d = where
                path = os.path.join(d, name)
                if mask & I.ISDIR:
                    if name in self.skip:
                        continue
                    if mask & (I.CREATE | I.MOVED_TO):
                        for k, v in self.walk(ri, path).items():
                            self.upsert(k, v)
                    elif mask & I.MOVED_FROM:
                        self.drop_tree(path)
                    continue
                kind, ext = kind_of(name)
                if not kind:
                    continue
                key = (ri, os.path.relpath(path, self.roots[ri]).replace(os.sep, "/"))
                if mask & (I.CLOSE_WRITE | I.MOVED_TO):
                    try:
                        st = os.stat(path)
                    except OSError:
                        continue
                    self.upsert(key, (st.st_size, st.st_mtime, kind, ext))
                elif mask & (I.DELETE | I.MOVED_FROM):
                    self.remove(key)
            except Exception as ex:  # keep watching no matter what
                print("event error:", ex, file=sys.stderr, flush=True)

    def drop_tree(self, path):
        prefix = path + os.sep
        for wd, (_, p) in list(self.wds.items()):
            if p == path or p.startswith(prefix):
                self.ino.rm(wd)
                self.wds.pop(wd, None)
        with self.lock:
            gone = [k for k, it in self.items.items() if it["abs"].startswith(prefix)]
        for k in gone:
            self.remove(k)

    def poll_loop(self):
        while not self.stopped:
            time.sleep(self.interval)
            if self.stopped:
                break
            try:
                self.poll_tick()
            except Exception as ex:
                print("scan error:", ex, file=sys.stderr, flush=True)

    def poll_tick(self):
        cur = self.scan_all()
        for k, v in cur.items():
            with self.lock:
                old = self.items.get(k)
            sig = v[:2]
            if old and (old["size"], old["mtime"]) == sig:
                self.pending.pop(k, None)
            elif self.pending.get(k) != sig:  # still being written; wait one more scan
                self.pending[k] = sig
            else:
                del self.pending[k]
                self.upsert(k, v)
        with self.lock:
            gone = [k for k in self.items if k not in cur]
        for k in gone:
            self.remove(k)
        for k in [k for k in self.pending if k not in cur]:
            del self.pending[k]


STATE_PATH = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                          "live-gallery", "state.json")


THUMB_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                         "live-gallery", "thumbs")
THUMB_MAX = 3 << 20


def image_type(head):
    if head[:8] == b"\x89PNG\r\n\x1a\n":
        return "image/png"
    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        return "image/webp"
    if head[:3] == b"\xff\xd8\xff":
        return "image/jpeg"
    return None


def thumb_file(tkey):
    return os.path.join(THUMB_DIR, tkey)


def prune_thumbs(keep=6000, limit=9000):
    """Thumbnails are keyed by path+mtime+size, so old versions pile up; drop the oldest."""
    try:
        with os.scandir(THUMB_DIR) as it:
            files = [(e.stat().st_mtime, e.path) for e in it if e.is_file()]
    except OSError:
        return
    if len(files) > limit:
        for _, path in sorted(files)[:len(files) - keep]:
            try:
                os.remove(path)
            except OSError:
                pass


def norm_roots(paths):
    roots, bad = [], []
    for p in paths:
        p = p.strip()
        if not p:
            continue
        r = os.path.abspath(os.path.expanduser(p))
        if not os.path.isdir(r):
            bad.append(p)
        elif r not in roots:
            roots.append(r)
    # a folder inside another watched folder is already covered; keep the outer one
    def inside(a, b):
        return a != b and os.path.normcase(a).startswith(os.path.normcase(b.rstrip(os.sep)) + os.sep)
    return [r for r in roots if not any(inside(r, o) for o in roots)], bad


def complete_dirs(prefix, limit=40):
    p = os.path.expanduser(prefix.strip())
    if not os.path.isabs(p):
        return []
    base, part = (p, "") if p.endswith(("/", os.sep)) else os.path.split(p)
    try:
        with os.scandir(base) as it:
            entries = sorted(it, key=lambda e: e.name.lower())
    except OSError:
        return []
    out, low = [], part.lower()
    for e in entries:
        if not e.name.lower().startswith(low) or (e.name.startswith(".") and not part.startswith(".")):
            continue
        try:
            if e.is_dir():
                out.append(os.path.join(base, e.name) + os.sep)
        except OSError:
            continue
        if len(out) >= limit:
            break
    return out


class App:
    """Owns the current Watcher and the browser connections, so the watched folder can change live."""

    def __init__(self, interval, exclude, poll, initial):
        self.opts = (interval, exclude, poll)
        self.initial = initial
        self.lock = threading.Lock()
        self.clients = []
        self.w = None
        self.indexing = False
        self.gen = 0
        try:
            with open(STATE_PATH) as f:
                self.state = json.load(f)
            assert isinstance(self.state, dict)
        except (OSError, ValueError, AssertionError):
            self.state = {}

    def save_state(self):
        try:
            os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
            with open(STATE_PATH + ".tmp", "w") as f:
                json.dump(self.state, f, indent=2)
            os.replace(STATE_PATH + ".tmp", STATE_PATH)
        except OSError as ex:
            print("could not save state:", ex, file=sys.stderr)

    def broadcast(self, ev):
        msg = json.dumps(ev)
        with self.lock:
            for q in self.clients:
                q.put(msg)

    def set_roots(self, roots, save=True):
        interval, exclude, poll = self.opts
        w = Watcher(roots, interval, exclude, poll, hub=self)
        with self.lock:
            old, self.w, self.indexing = self.w, w, True
            self.gen += 1
            gen = self.gen
        if old:
            old.stop()
        if save:
            recent = [r for r in self.state.get("recent", []) if r != roots]
            self.state.update(roots=roots, recent=[roots] + recent[:11])
            self.save_state()
        self.broadcast({"type": "reset"})
        print(f"indexing {', '.join(roots)} ...", flush=True)

        def run():
            t = time.time()
            w.start()
            with self.lock:
                current = gen == self.gen
                if current:
                    self.indexing = False
            if current:
                print(f"watching {', '.join(roots)}: {len(w.items)} images/models, "
                      f"indexed in {time.time() - t:.1f}s ({w.mode()})", flush=True)
                self.broadcast({"type": "reset"})

        threading.Thread(target=run, daemon=True).start()

    def listing(self, q):
        """Newest first. `before`/`before_id` continue from the last item of the previous page."""
        with self.lock:
            w, indexing = self.w, self.indexing
        with w.lock:
            items = list(w.items.values())
        everything = len(items)
        kind, text = q.get("kind"), (q.get("q") or "").lower()
        try:
            root = int(q["root"]) if "root" in q else None
            limit = max(1, min(500, int(q.get("limit") or self.initial)))
            before = (float(q["before"]), q.get("before_id", "")) if "before" in q else None
        except ValueError:
            root, limit, before = None, self.initial, None
        if kind or text or root is not None:
            items = [i for i in items if (not kind or i["kind"] == kind) and (root is None or i["root"] == root)
                     and (not text or text in i["rel"].lower())]
        total = len(items)
        order = lambda i: (i["mtime"], i["id"])
        if before:
            items = [i for i in items if order(i) < before]
        items.sort(key=order, reverse=True)
        page = [dict(i, thumb=os.path.exists(thumb_file(i["tkey"]))) for i in items[:limit]]
        return {"roots": w.roots, "total": total, "all": everything, "items": page, "more": len(items) > limit,
                "indexing": indexing, "mode": w.mode(), "recent": self.state.get("recent", [])}

    def save_thumb(self, item_id, version, body):
        ri, _, rel = item_id.partition("/")
        try:
            key, version = (int(ri), rel), float(version)
        except ValueError:
            return False
        w = self.w
        with w.lock:
            item = w.items.get(key)
        if not item or item["mtime"] != version:  # the file changed since this thumbnail was made
            return False
        try:
            os.makedirs(THUMB_DIR, exist_ok=True)
            tmp = thumb_file(item["tkey"]) + f".{threading.get_ident()}.tmp"
            with open(tmp, "wb") as f:
                f.write(body)
            os.replace(tmp, thumb_file(item["tkey"]))
        except OSError as ex:
            print("could not save thumbnail:", ex, file=sys.stderr)
            return False
        return True


IMMUTABLE = "private, max-age=31536000, immutable"


def make_handler(app):
    class H(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"  # keep-alive: a page of thumbnails reuses its connections
        timeout = 300

        def log_message(self, *a):
            pass

        def do_GET(self):
            u = urllib.parse.urlsplit(self.path)
            path = u.path
            q = {k: v[0] for k, v in urllib.parse.parse_qs(u.query).items()}
            if path == "/":
                return self.send_bytes(PAGE.encode(), "text/html; charset=utf-8")
            if path == "/kit.js":
                return self.send_bytes(KIT_JS.encode(), "text/javascript; charset=utf-8")
            if path == "/worker.js":
                return self.send_bytes(WORKER_JS.encode(), "text/javascript; charset=utf-8")
            if path == "/api/list":
                return self.send_json(app.listing(q))
            if path == "/api/dirs":
                return self.send_json({"dirs": complete_dirs(q.get("prefix", ""))})
            if path == "/events":
                return self.events()
            if path.startswith("/f/"):
                return self.file(path[3:], versioned="v" in q)
            if path.startswith("/t/"):
                return self.thumb(path[3:])
            self.send_error(404)

        def do_POST(self):
            u = urllib.parse.urlsplit(self.path)
            ctype = self.headers.get("Content-Type", "")
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                n = -1
            if not 0 <= n <= THUMB_MAX:
                return self.send_error(413)  # also closes the connection, so the body is never read
            body = self.rfile.read(n)
            if u.path == "/api/thumb":
                # image/* is not a "simple" content type, so other websites can't post here
                q = {k: v[0] for k, v in urllib.parse.parse_qs(u.query).items()}
                if not ctype.startswith("image/") or not image_type(body[:16]):
                    return self.send_json({"error": "expected an image"}, 415)
                return self.send_json({"ok": app.save_thumb(q.get("id", ""), q.get("v", ""), body)})
            if u.path != "/api/watch":
                return self.send_error(404)
            # JSON-only, so other websites can't trigger this with a plain form post
            if not ctype.startswith("application/json"):
                return self.send_json({"error": "expected JSON"}, 415)
            try:
                paths = json.loads(body or b"{}").get("roots")
                if isinstance(paths, str):
                    paths = [paths]
                if not isinstance(paths, list) or not all(isinstance(p, str) for p in paths):
                    raise ValueError
            except (ValueError, AttributeError):
                return self.send_json({"error": "bad request"}, 400)
            roots, bad = norm_roots(paths)
            if bad:
                return self.send_json({"error": "not a folder: " + ", ".join(bad)}, 400)
            if not roots:
                return self.send_json({"error": "enter a folder path"}, 400)
            app.set_roots(roots)
            return self.send_json({"ok": True, "roots": roots})

        def send_json(self, obj, status=200):
            return self.send_bytes(json.dumps(obj).encode(), "application/json", status)

        def send_bytes(self, body, ctype, status=200, cache="no-store"):
            self.send_response(status)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", cache)
            self.end_headers()
            self.wfile.write(body)

        def thumb(self, tkey):
            if len(tkey) != 40 or any(c not in "0123456789abcdef" for c in tkey):
                return self.send_error(404)
            try:
                with open(thumb_file(tkey), "rb") as f:
                    body = f.read()
            except OSError:
                return self.send_error(404)
            self.send_bytes(body, image_type(body[:16]) or "application/octet-stream", cache=IMMUTABLE)

        def file(self, rest, versioned=False):
            w = app.w
            ri, _, rel = rest.partition("/")
            try:
                ri = int(ri)
                root = w.roots[ri]
            except (ValueError, IndexError):
                return self.send_error(404)
            rel = urllib.parse.unquote(rel)
            full = os.path.realpath(os.path.join(root, rel))
            rroot = os.path.realpath(root)
            try:  # normcase: Windows paths are case-insensitive; different drives raise ValueError
                inside = os.path.normcase(os.path.commonpath([full, rroot])) == os.path.normcase(rroot)
            except ValueError:
                inside = False
            with w.lock:
                listed = (ri, os.path.normpath(rel).replace(os.sep, "/")) in w.items
            if not (inside or listed) or not os.path.isfile(full):
                return self.send_error(404)
            try:
                f = open(full, "rb")
            except OSError:
                return self.send_error(404)
            with f:
                self.send_response(200)
                self.send_header("Content-Type", mimetypes.guess_type(full)[0] or "application/octet-stream")
                self.send_header("Content-Length", str(os.fstat(f.fileno()).st_size))
                # ?v=<mtime> URLs never change content, so the browser can keep them
                self.send_header("Cache-Control", IMMUTABLE if versioned else "no-cache")
                self.end_headers()
                try:
                    while chunk := f.read(1 << 20):
                        self.wfile.write(chunk)
                except (BrokenPipeError, ConnectionResetError):
                    self.close_connection = True

        def events(self):
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "close")  # an endless stream has no length
            self.end_headers()
            q = queue.Queue()
            with app.lock:
                app.clients.append(q)
            try:
                self.wfile.write(b": hi\n\n")
                self.wfile.flush()
                while True:
                    try:
                        self.wfile.write(f"data: {q.get(timeout=15)}\n\n".encode())
                    except queue.Empty:
                        self.wfile.write(b": ping\n\n")
                    self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass
            finally:
                with app.lock:
                    app.clients.remove(q)

    return H


