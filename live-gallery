def main():
    ap = argparse.ArgumentParser(description="Live, recursive gallery of new images and 3D models.")
    ap.add_argument("dirs", nargs="*", help="folders to watch (default: the last folder picked in the page, "
                                            "else --default, else the current folder)")
    ap.add_argument("--default", help="folder to watch when no DIR is given and none was picked yet")
    ap.add_argument("-p", "--port", type=int, default=None, help="port (default 8765, or the next free one)")
    ap.add_argument("-i", "--interval", type=float, default=1.0, help="seconds between scans (default 1)")
    ap.add_argument("-n", "--initial", type=int, default=60,
                    help="files per page: the newest N load first, older ones as you scroll (default 60)")
    ap.add_argument("-x", "--exclude", action="append", default=[], help="folder name to skip (repeatable)")
    ap.add_argument("--poll", action="store_true", help="poll instead of using inotify")
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--open", action="store_true", help="open the browser")
    a = ap.parse_args()

    app = App(a.interval, a.exclude, a.poll, a.initial)
    if a.dirs:
        roots, bad = norm_roots(a.dirs)
        if bad:
            sys.exit("not a directory: " + ", ".join(bad))
    else:
        roots = norm_roots(app.state.get("roots") or [])[0] or norm_roots([a.default or "."])[0]
        if not roots:
            sys.exit(f"not a directory: {a.default}")
    app.set_roots(roots, save=False)  # indexes in the background; the page shows progress
    threading.Thread(target=prune_thumbs, daemon=True).start()

    srv = None
    ports = [a.port] if a.port else range(8765, 8785)
    for port in ports:
        try:
            srv = ThreadingHTTPServer((a.host, port), make_handler(app))
            break
        except OSError:
            continue
    if not srv:
        sys.exit(f"port unavailable: {a.port or '8765-8784'}")
    srv.daemon_threads = True
    host = "localhost" if a.host in ("127.0.0.1", "0.0.0.0") else a.host
    url = f"http://{host}:{srv.server_address[1]}/"
    print(f"Live Gallery: {url}   (change folders in the page; Ctrl+C to stop)", flush=True)
    if a.open:
        webbrowser.open(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print()


if __name__ == "__main__":
    main()
