{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Live Gallery",
  "description": "Real-time stream of agent-created 3D models, images, videos, audio, text, and code.",
  "has_web_ui": true,
  "ui_config": {
    "display_name": "Live Gallery",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Live Gallery",
        "file_extensions": [
          ".glb", ".gltf", ".obj", ".stl", ".ply", ".fbx",
          ".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg",
          ".mp4", ".webm", ".mov"
        ]
      }
    ]
  }
}
